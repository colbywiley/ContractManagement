<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>allInternalUsers</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Contract_Title__c</field>
        <field>Contract_Type__c</field>
        <field>Contract_Subject_Picklist__c</field>
        <field>Contract_Value__c</field>
        <field>Staff_Liaison__c</field>
        <field>Approval_Path__c</field>
        <field>Branch_ED__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Branch_ED__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Branch ED Sole Approval</label>
        <name>Branch_ED_Sole_Approval</name>
    </approvalStep>
    <description>Approval process for contracts requiring only Branch ED approval (Section 3.2.4). Single-step approval for lower-value contracts.</description>
    <entryCriteria>
        <criteriaItems>
            <field>YGSF_Contract__c.Approval_Path__c</field>
            <operation>equals</operation>
            <value>Section 3.2.4 - Branch ED Only</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>Section 3.2.4 Approval</label>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
