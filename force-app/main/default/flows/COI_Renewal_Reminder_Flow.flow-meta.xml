<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>Schedule-Triggered Flow that runs daily. Queries Contract_Document__c records where Document_Type__c is "COI" and Expiration_Date__c is within 30 days. Sends reminder emails to the parent contract's Staff Liaison to obtain updated certificates of insurance before they expire.</description>
    <interviewLabel>COI Renewal Reminder {!$Flow.CurrentDateTime}</interviewLabel>
    <label>COI Renewal Reminder</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>

    <!-- Formula: 30 days from today -->
    <formulas>
        <name>frmCOIExpirationThreshold</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 30</expression>
    </formulas>

    <!-- Start: Schedule-Triggered, runs daily -->
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Expiring_COIs</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-01-01</startDate>
            <startTime>07:30:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>

    <!-- Get Expiring COI Documents -->
    <recordLookups>
        <name>Get_Expiring_COIs</name>
        <label>Get Expiring COI Documents</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <connector>
            <targetReference>Decision_Has_Expiring_COIs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Document_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>COI</stringValue>
            </value>
        </filters>
        <filters>
            <field>Expiration_Date__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>frmCOIExpirationThreshold</elementReference>
            </value>
        </filters>
        <filters>
            <field>Expiration_Date__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Contract_Document__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Contract__c</queriedFields>
        <queriedFields>File_Name__c</queriedFields>
        <queriedFields>Expiration_Date__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <!-- Decision: Any expiring COIs? -->
    <decisions>
        <name>Decision_Has_Expiring_COIs</name>
        <label>Has Expiring COIs?</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <defaultConnectorLabel>No Expiring COIs</defaultConnectorLabel>
        <rules>
            <name>Has_Expiring_COIs</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Expiring_COIs</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Expiring_COIs</targetReference>
            </connector>
            <label>Has Expiring COIs</label>
        </rules>
    </decisions>

    <!-- Loop Expiring COIs -->
    <loops>
        <name>Loop_Expiring_COIs</name>
        <label>Loop Through Expiring COIs</label>
        <locationX>176</locationX>
        <locationY>398</locationY>
        <collectionReference>Get_Expiring_COIs</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Get_Parent_Contract</targetReference>
        </nextValueConnector>
    </loops>

    <!-- Get Parent Contract for current COI -->
    <recordLookups>
        <name>Get_Parent_Contract</name>
        <label>Get Parent Contract</label>
        <locationX>352</locationX>
        <locationY>518</locationY>
        <connector>
            <targetReference>Decision_Has_Parent_Contract</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_Expiring_COIs.Contract__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>YGSF_Contract__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Contract_Title__c</queriedFields>
        <queriedFields>Counterparty_Name__c</queriedFields>
        <queriedFields>Staff_Liaison__c</queriedFields>
        <queriedFields>Staff_Liaison__r.Email</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <!-- Decision: Parent contract found? -->
    <decisions>
        <name>Decision_Has_Parent_Contract</name>
        <label>Parent Contract Found?</label>
        <locationX>352</locationX>
        <locationY>638</locationY>
        <defaultConnector>
            <targetReference>Loop_Expiring_COIs</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Parent Contract</defaultConnectorLabel>
        <rules>
            <name>Parent_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Parent_Contract</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_COI_Reminder</targetReference>
            </connector>
            <label>Parent Found</label>
        </rules>
    </decisions>

    <!-- Send COI Renewal Reminder -->
    <actionCalls>
        <name>Send_COI_Reminder</name>
        <label>Send COI Renewal Reminder</label>
        <locationX>352</locationX>
        <locationY>758</locationY>
        <connector>
            <targetReference>Loop_Expiring_COIs</targetReference>
        </connector>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddressesArray</name>
            <value>
                <elementReference>Get_Parent_Contract.Staff_Liaison__r.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>COI Expiring Soon: {!Get_Parent_Contract.Contract_Title__c}</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <stringValue>A Certificate of Insurance (COI) associated with one of your contracts is expiring soon and needs to be renewed.

Contract Title: {!Get_Parent_Contract.Contract_Title__c}
Counterparty: {!Get_Parent_Contract.Counterparty_Name__c}
COI Document: {!Loop_Expiring_COIs.File_Name__c}
COI Expiration Date: {!Loop_Expiring_COIs.Expiration_Date__c}

Please contact the counterparty to obtain an updated COI and upload it to the contract record. An expired COI may put the Association at risk.</stringValue>
            </value>
        </inputParameters>
    </actionCalls>
</Flow>
