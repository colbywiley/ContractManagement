<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Board_Approval</fullName>
    <active>true</active>
    <errorConditionFormula>AND(Board_Approval_Required__c, ISBLANK(Board_Approval_Date__c), ISPICKVAL(Status__c, "Fully Executed"))</errorConditionFormula>
    <errorMessage>Board of Directors approval is required before this contract can be fully executed.</errorMessage>
</ValidationRule>
